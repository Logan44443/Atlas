    { "type": "pine",      "perChunk": 70, "minHeight": 8,  "maxHeight": 70, "minSlopeY": 0.8,  "scale": [0.8, 1.5], "clusterScale": 140, "clusterThreshold": 0.05 },
    { "type": "broadleaf", "perChunk": 45, "minHeight": 3,  "maxHeight": 40, "minSlopeY": 0.85, "scale": [0.8, 1.4], "clusterScale": 110, "clusterThreshold": 0.15 },
